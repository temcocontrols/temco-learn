{
  "name": "temco-learn",
  "version": "0.1.1",
  "private": true,
  "description": "The Temco Learn documentation site: six sections, every project, every version.",
  "type": "module",
  "scripts": {
    "client-dev": "vite",
    "build": "node --experimental-strip-types scripts/catalog.mts && node --experimental-strip-types scripts/search.mts && tsc --noEmit && vite build && node --experimental-strip-types scripts/pdf.mts && node --experimental-strip-types scripts/chm.mts",
    "build:fast": "node --experimental-strip-types scripts/catalog.mts && node --experimental-strip-types scripts/search.mts && tsc --noEmit && vite build",
    "serve": "vite preview",
    "catalog": "node --experimental-strip-types scripts/catalog.mts",
    "search": "node --experimental-strip-types scripts/search.mts",
    "pdf": "node --experimental-strip-types scripts/pdf.mts",
    "chm": "node --experimental-strip-types scripts/chm.mts",
    "check": "tsc --noEmit && node --experimental-strip-types scripts/check-content.mts && eslint .",
    "lint": "eslint .",
    "guard": "node --experimental-strip-types scripts/check-artifacts.mts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.11",
    "@fluentui/react-icons": "^2.0.344",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7"
  }
}
